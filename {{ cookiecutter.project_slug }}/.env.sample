# Development defaults. The app runs an embedded NATS server and keeps keys
# and data in DATA_DIR. See README.md for production settings.
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data
# NATS_PORT=4222
# NATS_WS_PORT=4223

# Production uses an external NATS server:
# APP_ENV=production
# NATS_EMBEDDED=false
# NATS_URL=tls://nats.example.com:4222
# NATS_RUNTIME_FILE=/run/secrets/nats-runtime.json
# NATS_BROWSER_URL=wss://nats.example.com
# COOKIE_SECURE=true
# TRUSTED_PROXIES=10.0.0.0/8
# NATS_REPLICAS=3

# Lifetimes
# SESSION_TTL=168h
# CONNECT_TOKEN_TTL=60s
# USER_JWT_TTL=15m
# OIDC_REFRESH_MARGIN=2m

# OIDC sign-in (optional). Keep the client secret out of this file in production.
# OIDC_ISSUER=https://auth.example.com/application/o/notes/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://app.example.com/auth/oidc/callback
# OIDC_SCOPES=openid profile offline_access
