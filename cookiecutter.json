{
  "project_name": "go-nats-app",
  "project_slug": "{{ '-'.join(cookiecutter['project_name'].lower().split()).replace('_', '-') }}",
  "github_username": "danielmichaels",
  "go_module_path": "github.com/{{ cookiecutter.github_username.strip() }}/{{ cookiecutter.project_slug }}",
  "cmd_name": "app",
  "project_description": "A NATS-first application with persistent login and live updates",
  "docker_registry": "ghcr.io/{{ cookiecutter.github_username.strip() }}",
  "frontend": [
    "datastar",
    "react"
  ],
  "_copy_without_render": [
    "web/*",
    "internal/oidctest/*",
    "internal/htmlui/static/*",
    "internal/spa/dist/*"
  ]
}
